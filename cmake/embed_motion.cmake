# Usage: cmake -DMOTION_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_motion.cmake
# Emits sim_embedded_motion (src/sim.h): every .json under <MOTION_DIR> (the hand model, later the
# built-in gestures) as zero-terminated text, named by its path below <MOTION_DIR> without .json and
# sorted, so the library carries them (docs/hand-motion.md).

string(REPEAT "[0-9a-f]" 64 line_pattern)

file(GLOB_RECURSE jsons LIST_DIRECTORIES false RELATIVE ${MOTION_DIR} ${MOTION_DIR}/*.json)
list(SORT jsons)
set(arrays "")
set(entries "")
set(count 0)
foreach (json ${jsons})
    string(REGEX REPLACE "\\.json$" "" name ${json})
    string(MAKE_C_IDENTIFIER ${name} symbol)
    file(READ ${MOTION_DIR}/${json} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "static const u8 motion_${symbol}[] = {\n${bytes}0x00};\n")
    string(APPEND entries "    { .name = \"${name}\", .json = (const char*)motion_${symbol} },\n")
    math(EXPR count "${count} + 1")
endforeach ()

if (count EQUAL 0)
    set(entries "    {},\n")
endif ()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_motion.cmake from motion/\n#include \"sim.h\"\n\n${arrays}\nextern const SIM_EmbeddedMotion sim_embedded_motion[] = {\n${entries}};\nextern const u32 sim_embedded_motion_count = ${count};\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
