# Usage: cmake -DDIR=<dir> -DSYMBOL=<name> -DOUTPUT=<file.cpp> -P embed_motion.cmake
# Emits <SYMBOL> (src/sim.h): every .json under <DIR> as zero-terminated text, named by its path below
# <DIR> without .json and sorted, so the library carries them: data/motion as sim_embedded_motion
# (docs/hand-motion.md), data/devices as sim_embedded_devices (docs/openxr.md, Render models).

string(REPEAT "[0-9a-f]" 64 line_pattern)

file(GLOB_RECURSE jsons LIST_DIRECTORIES false RELATIVE ${DIR} ${DIR}/*.json)
list(SORT jsons)
set(arrays "")
set(entries "")
set(count 0)
foreach (json ${jsons})
    string(REGEX REPLACE "\\.json$" "" name ${json})
    string(MAKE_C_IDENTIFIER ${name} symbol)
    file(READ ${DIR}/${json} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "static const u8 motion_${symbol}[] = {\n${bytes}0x00};\n")
    string(APPEND entries "    { .name = \"${name}\", .json = (const char*)motion_${symbol} },\n")
    math(EXPR count "${count} + 1")
endforeach ()

if (count EQUAL 0)
    set(entries "    {},\n")
endif ()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_motion.cmake\n#include \"sim.h\"\n\n${arrays}\nextern const SIM_EmbeddedMotion ${SYMBOL}[] = {\n${entries}};\nextern const u32 ${SYMBOL}_count = ${count};\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
