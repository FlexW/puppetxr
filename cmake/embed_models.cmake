# Usage: cmake -DMODELS_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_models.cmake
# Emits w_embedded_models (src/world.h): <MODELS_DIR>/<name>/<name>.glb of every model directory,
# sorted by name, so the library carries its built-in mesh props.

# 32 bytes a line keeps the file readable for compilers and editors
string(REPEAT "[0-9a-f]" 64 line_pattern)

file(GLOB glbs LIST_DIRECTORIES false ${MODELS_DIR}/*/*.glb)
list(SORT glbs)
set(arrays "")
set(entries "")
set(count 0)
foreach (glb ${glbs})
    get_filename_component(dir ${glb} DIRECTORY)
    get_filename_component(name ${dir} NAME)
    get_filename_component(file_name ${glb} NAME_WE)
    if (NOT file_name STREQUAL name)
        continue()
    endif ()
    string(MAKE_C_IDENTIFIER ${name} symbol)
    file(READ ${glb} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(SIZE ${glb} size)
    string(APPEND arrays "static const u8 model_${symbol}[] = {\n${bytes}};\n")
    string(APPEND entries "    { .name = \"${name}\", .data = model_${symbol}, .size = ${size} },\n")
    math(EXPR count "${count} + 1")
endforeach ()

if (count EQUAL 0)
    set(entries "    {},\n")
endif ()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_models.cmake from models/\n#include \"world.h\"\n\n${arrays}\nextern const W_EmbeddedModel w_embedded_models[] = {\n${entries}};\nextern const u32 w_embedded_models_count = ${count};\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
