# cmake -DFILES=<a;b> [-DALLOW=<prefix;...>] -P check_dylibs.cmake
# Fails unless every file links only libraries of macOS itself, under /usr/lib and /System, so the
# release runs on a Mac without Homebrew (docs/building.md, macOS releases). ALLOW replaces the
# allowed prefixes, for the test of this check.

cmake_minimum_required(VERSION 3.25)

if (NOT ALLOW)
    set(ALLOW /usr/lib/ /System/)
endif ()
set(failed FALSE)
foreach (file ${FILES})
    execute_process(COMMAND otool -L ${file} OUTPUT_VARIABLE dump RESULT_VARIABLE result)
    execute_process(COMMAND otool -D ${file} OUTPUT_VARIABLE id)
    if (NOT result EQUAL 0)
        message(SEND_ERROR "otool -L ${file} failed")
        set(failed TRUE)
        continue()
    endif ()
    # A dylib lists its own install name too, once per architecture of a universal file
    string(REGEX MATCHALL "\n[^\n:]+" ids "${id}")
    list(TRANSFORM ids STRIP)
    string(REGEX MATCHALL "\n\t[^ \n]+" libraries "${dump}")
    list(REMOVE_DUPLICATES libraries)
    foreach (entry ${libraries})
        string(STRIP "${entry}" library)
        if (library IN_LIST ids)
            continue()
        endif ()
        set(allowed FALSE)
        foreach (prefix ${ALLOW})
            string(FIND "${library}" "${prefix}" at)
            if (at EQUAL 0)
                set(allowed TRUE)
            endif ()
        endforeach ()
        if (NOT allowed)
            message(SEND_ERROR "${file} links ${library}")
            set(failed TRUE)
        endif ()
    endforeach ()
endforeach ()
if (failed)
    message(FATAL_ERROR "Not portable: ${FILES}")
endif ()
