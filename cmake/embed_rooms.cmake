# Usage: cmake -DROOMS_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_rooms.cmake
# Emits w_embedded_rooms (src/world.h): room.json (terminated), room.bin and room_albedo.png of
# every <ROOMS_DIR>/<name>/ with a room.json, sorted by name, so the library carries its rooms.

# 32 bytes a line keeps the file readable for compilers and editors
string(REPEAT "[0-9a-f]" 64 line_pattern)

function(append_bytes out_var path)
    file(READ ${path} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    set(${out_var} "${bytes}" PARENT_SCOPE)
endfunction()

file(GLOB jsons LIST_DIRECTORIES false ${ROOMS_DIR}/*/room.json)
list(SORT jsons)
set(arrays "")
set(entries "")
set(count 0)
foreach (json ${jsons})
    get_filename_component(dir ${json} DIRECTORY)
    get_filename_component(name ${dir} NAME)
    string(MAKE_C_IDENTIFIER ${name} symbol)

    append_bytes(json_bytes ${json})
    string(APPEND arrays "static const u8 room_${symbol}_json[] = {\n${json_bytes}0x00};\n")

    append_bytes(binary_bytes ${dir}/room.bin)
    file(SIZE ${dir}/room.bin binary_size)
    string(APPEND arrays "static const u8 room_${symbol}_bin[] = {\n${binary_bytes}};\n")

    set(image "nullptr")
    set(image_size 0)
    if (EXISTS ${dir}/room_albedo.png)
        append_bytes(image_bytes ${dir}/room_albedo.png)
        file(SIZE ${dir}/room_albedo.png image_size)
        string(APPEND arrays "static const u8 room_${symbol}_albedo[] = {\n${image_bytes}};\n")
        set(image "room_${symbol}_albedo")
    endif ()

    string(APPEND entries "    { .name = \"${name}\", .source = { .json = (const char*)room_${symbol}_json, .binary = room_${symbol}_bin, .binary_size = ${binary_size}, .image = ${image}, .image_size = ${image_size} } },\n")
    math(EXPR count "${count} + 1")
endforeach ()

if (count EQUAL 0)
    set(entries "    {},\n")
endif ()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_rooms.cmake from rooms/\n#include \"world.h\"\n\n${arrays}\nextern const W_EmbeddedRoom w_embedded_rooms[] = {\n${entries}};\nextern const u32 w_embedded_rooms_count = ${count};\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
