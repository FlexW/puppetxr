# Usage: cmake -DDIR=<dir> -DOUTPUT=<file.cpp> -P embed_icon.cmake
# Emits oxr_embedded_icon (src/oxr.h): every <DIR>/puppetxr_<size>.rgba, square 8-bit RGBA made by
# tools/gen_icon.sh, smallest first, as the mirror window's icon.

string(REPEAT "[0-9a-f]" 64 line_pattern)

file(GLOB images LIST_DIRECTORIES false RELATIVE ${DIR} ${DIR}/puppetxr_*.rgba)
set(sizes "")
foreach (image ${images})
    string(REGEX REPLACE "^puppetxr_([0-9]+)\\.rgba$" "\\1" size ${image})
    list(APPEND sizes ${size})
endforeach ()
list(SORT sizes COMPARE NATURAL)
set(arrays "")
set(entries "")
set(count 0)
foreach (size ${sizes})
    set(path ${DIR}/puppetxr_${size}.rgba)
    file(SIZE ${path} bytes_count)
    math(EXPR expected "${size} * ${size} * 4")
    if (NOT bytes_count EQUAL expected)
        message(FATAL_ERROR "${path} has ${bytes_count} bytes, not the ${expected} of ${size}x${size} RGBA")
    endif ()
    file(READ ${path} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "static const u8 icon_${size}[] = {\n${bytes}};\n")
    string(APPEND entries "    { .rgba = icon_${size}, .width = ${size}, .height = ${size} },\n")
    math(EXPR count "${count} + 1")
endforeach ()

if (count EQUAL 0)
    message(FATAL_ERROR "No puppetxr_<size>.rgba in ${DIR}; run tools/gen_icon.sh")
endif ()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_icon.cmake\n#include \"oxr.h\"\n\n${arrays}\nextern const OS_IconImage oxr_embedded_icon[] = {\n${entries}};\nextern const u32 oxr_embedded_icon_count = ${count};\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
