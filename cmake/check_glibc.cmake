# cmake -DOBJDUMP=<objdump> -DFILES=<a;b> [-DMAX_GLIBC=2.28] -P check_glibc.cmake
# Fails unless every file depends on glibc alone, so the binaries run on any distribution with
# that glibc: no libstdc++ or libgcc_s (linked statically, docs/building.md) and, with MAX_GLIBC,
# no symbol version newer than it.

cmake_minimum_required(VERSION 3.25)

set(allowed libc.so.6 libm.so.6 libdl.so.2 libpthread.so.0 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1)
set(failed FALSE)
foreach (file ${FILES})
    execute_process(COMMAND ${OBJDUMP} -p ${file} OUTPUT_VARIABLE dump RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
        message(SEND_ERROR "${OBJDUMP} -p ${file} failed")
        set(failed TRUE)
        continue()
    endif ()
    string(REGEX MATCHALL "NEEDED +[^\n]+" needed "${dump}")
    foreach (entry ${needed})
        string(REGEX REPLACE "NEEDED +" "" library "${entry}")
        if (NOT library IN_LIST allowed)
            message(SEND_ERROR "${file} needs ${library}")
            set(failed TRUE)
        endif ()
    endforeach ()
    if (MAX_GLIBC)
        string(REGEX MATCHALL "GLIBC_[0-9.]+" versions "${dump}")
        list(REMOVE_DUPLICATES versions)
        foreach (version ${versions})
            string(REPLACE "GLIBC_" "" number "${version}")
            if (number VERSION_GREATER MAX_GLIBC)
                message(SEND_ERROR "needs ${version}, newer than ${MAX_GLIBC}: ${file}")
                set(failed TRUE)
            endif ()
        endforeach ()
    endif ()
endforeach ()
if (failed)
    message(FATAL_ERROR "Not portable: ${FILES}")
endif ()
