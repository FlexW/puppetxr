{
 "format": "puppetxr-gesture",
 "version": 1,
 "name": "swipe_left",
 "description": "Swipe the open hand to the left in front of the body",
 "hands": ["right"],
 "params": {
  "distance": { "type": "number", "default": 0.5, "min": 0.05, "max": 1 }
 },
 "steps": [
  { "anchor": "palm", "to": "head + forward * 0.4 + down * 0.22 + outward * 0.16 + sideways * (distance * 0.5)", "palm": "swipe_in", "duration": 0.4 },
  { "shape": "wave", "duration": 0.3, "with": "previous" },
  { "anchor": "palm", "to": "head + forward * 0.4 + down * 0.22 + outward * 0.16 - sideways * (distance * 0.5)", "duration": 0.4, "event": "swipe" },
  { "path": "home", "duration": 0.5 },
  { "shape": "idle", "duration": 0.3, "with": "previous" }
 ]
}
