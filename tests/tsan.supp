# ThreadSanitizer suppressions for code we do not build: system libraries, Vulkan and GL drivers.
# Drivers are not instrumented, so their own threads race on memory TSan cannot see synchronized.
# Never suppress a report in puppetxr itself; fix it.
deadlock:libdbus-1.so
race:libgallium
race:libvulkan_lvp
race:libvulkan_radeon
race:libLLVM
race:libEGL_mesa
race:libGLX_mesa
