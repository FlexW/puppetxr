 #include "SampleEditor.h"
+#include "Editor.h"
+#include "HAL/IConsoleManager.h"
+#include "PlayInEditorDataTypes.h"
 
 #define LOCTEXT_NAMESPACE "FSampleEditorModule"
 
+// puppetxr's tests: the toolbar's VR Preview, which no console command or script API starts
+static FAutoConsoleCommand PuppetxrVRPreview(TEXT("puppetxr.VRPreview"), TEXT("Starts a VR Preview session as the toolbar's VR Preview does"),
+	FConsoleCommandDelegate::CreateLambda([]() {
+		if (GEditor && !GEditor->PlayWorld && !GEditor->IsPlaySessionRequestQueued())
+		{
+			FRequestPlaySessionParams SessionParams;
+			SessionParams.SessionPreviewTypeOverride = EPlaySessionPreviewType::VRPreview;
+			GEditor->RequestPlaySession(SessionParams);
+		}
+	}));
+
 void FSampleEditorModule::StartupModule()
 {
 }
