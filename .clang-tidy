# clang-tidy for our sources (docs/building.md). Checks that contradict docs/style.md (C casts,
# C arrays, macros, pointer arithmetic, varargs logging, typedefs, `if (ptr)`, short names,
# trailing return types) are off; everything else that finds bugs or keeps code const is on.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -bugprone-incorrect-roundings,
  -bugprone-invalid-enum-default-initialization,
  cert-err33-c,
  cert-err34-c,
  cert-dcl16-c,
  concurrency-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-member-init,
  misc-*,
  -misc-include-cleaner,
  -misc-misplaced-const,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-override-with-different-visibility,
  modernize-use-nullptr,
  modernize-redundant-void-arg,
  modernize-use-override,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  portability-*,
  -portability-avoid-pragma-once,
  readability-braces-around-statements,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-isolate-declaration,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-casting,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-nested-if,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
CheckOptions:
  misc-const-correctness.AnalyzeValues: true
  misc-const-correctness.AnalyzeReferences: true
  misc-const-correctness.AnalyzePointers: true
  misc-const-correctness.WarnPointersAsValues: false
  misc-const-correctness.WarnPointersAsPointers: true
  misc-const-correctness.TransformPointersAsPointers: true
  misc-use-internal-linkage.FixMode: UseStatic
  # De Morgan rewrites change the result for NaN: !(x > a && x < b) is true for NaN, x <= a || x >= b is false
  readability-simplify-boolean-expr.SimplifyDeMorgan: false
